# Dependențele nu au nevoie de scripturi de instalare:
#  - better-sqlite3 vine cu binare precompilate (N-API) pentru toate platformele; fără această
#    setare npm ar încerca „node-gyp rebuild”, care eșuează pe calculatoarele fără compilator C++;
#  - Electron își descarcă binarul la prima pornire.
# Scripturile proprii ale proiectului (npm run dev / build / test) funcționează normal.
ignore-scripts=true
