{
  "name": "portofoliu-bursa",
  "productName": "Portofoliu Bursa",
  "version": "1.2.0",
  "description": "Aplicație desktop pentru monitorizarea investițiilor la bursă (acțiuni, ETF-uri, obligațiuni, crypto)",
  "author": "Portofoliu Bursa",
  "homepage": "https://github.com/Dariukkk923/portofoliu-bursa",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dariukkk923/portofoliu-bursa.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "smoke": "node scripts/smoke.mjs",
    "screens": "node scripts/screens.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "decimal.js": "^10.6.0",
    "yahoo-finance2": "^4.0.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cryptocurrency-icons": "^0.18.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.72.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
